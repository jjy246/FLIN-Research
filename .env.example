# Copy settings into your terminal environment or OS environment variables.
# This file is an example; it is NOT loaded automatically by FLIN.
# Never commit real API keys or personal data.

# Optional local Ollama author/reviewer models; not used for FLIN routing.
BRAIN_OLLAMA_MODEL=qwen3:4b-instruct
BRAIN_OLLAMA_FALLBACK=qwen2.5:3b
BRAIN_MODEL_GENERATOR=qwen3:4b-instruct
BRAIN_MODEL_JUDGE=qwen3:4b-instruct
BRAIN_MODEL_CRITIC=qwen2.5:3b
BRAIN_MODEL_REVISER=qwen3:4b-instruct

# The existing legacy data root is preserved automatically if found.
# BRAIN_DATA_DIR=/absolute/path/for/your/FLIN-data

# Optional public research provider configuration.
BRAIN_USE_OPENALEX=0
# OPENALEX_API_KEY=
# CROSSREF_MAILTO=you@example.com
# SEMANTIC_SCHOLAR_API_KEY=

# Tweak only if you understand memory/cost tradeoffs.
BRAIN_OVERVIEW_NODES=2200
BRAIN_UNLOAD_BETWEEN_MODELS=1
FLIN_IDLE_RETRY_SECONDS=900
